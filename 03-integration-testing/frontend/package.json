{
  "name": "03-integration-testing-backend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "check": "run-s lint typecheck type-coverage",
    "dev": "vite",
    "lint": "eslint",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:verbose": "vitest --reporter verbose",
    "test-coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "type-coverage": "type-coverage --at-least 100"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "bootstrap": "^5.3.8",
    "eslint": "^10.0.2",
    "globals": "^17.4.0",
    "happy-dom": "^20.8.3",
    "jiti": "^2.6.1",
    "npm-run-all2": "^7.0.2",
    "sass": "1.77.6",
    "type-coverage": "^2.29.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "axios": "^1.13.6"
  }
}
